    {
      "id": "file:scripts/helper.js",
      "type": "file",
      "label": "helper.js",
      "path": "scripts/helper.js",
      "properties": {
        "summary": "Browser-side WebSocket connection manager (IIFE) with exponential backoff reconnection, session key persistence, status pill UI, tombstone overlay on prolonged disconnection, and a click/choice event sender for the brainstorm companion interface."
      }
    },
    {
      "id": "file:scripts/server.cjs",
      "type": "file",
      "label": "server.cjs",
      "path": "scripts/server.cjs",
      "properties": {
        "summary": "Node.js HTTP+WebSocket server for the brainstorm companion. Serves framed/full-doc screens from a content directory, authenticates via per-session token (query/cookie), handles WebSocket upgrade/framing (RFC 6455), broadcasts reloads on file changes, tracks activity for idle shutdown, and monitors parent-process liveness."
      }
    },
